// ─── Prisma Schema ─────────────────────────────────────────────────────────────
// Phase 1: Infrastructure only — models will be added in Phase 2
// when the data requirements are fully specified.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

